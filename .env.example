# Copy this file to .env and adjust as needed.

# Base API host for auth and dashboard requests.
# When set, this value will be used for /api/auth and /api/dashboard calls.
# Example: VITE_API_URL=https://synq-backend.trustgrid.com
VITE_API_URL=https://synq-backend.trustgrid.com

# External active-users analytics API (not proxied through the local Express server)
VITE_ACTIVE_USERS_API_URL=https://synq-backend.trustgrid.com/api/dashboard/active-users

# Download-tracker service (ios/android/combined download stats) - a separate
# backend from VITE_API_URL, not proxied, no /api prefix on its routes.
VITE_DL_TRACKER_API_URL=https://dl-tracker.trustgrid.com

# Internal-login endpoint (/internal/login page), separate from the normal
# web login. Same PIN + '@Trustgrid' composition, different API endpoint.
VITE_INTERNAL_LOGIN_API_URL=https://synq-backend.trustgrid.com/api/auth/internal-login

# Which backend the login request targets when VITE_API_URL is not set.
# One of: production | staging | local
# production -> https://synq-backend.trustgrid.com
# staging    -> https://synq.trustgrid.com
# local      -> relative path, proxied to the local Express server on :5000
VITE_AUTH_API_ENV=local
